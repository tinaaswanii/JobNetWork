# --- artha.link (server-side ONLY, never NEXT_PUBLIC_) ---
ARTHA_API_KEY=ak_live_xxxxxxxxxxxxxxxxxxxx
ARTHA_BASE_URL=https://api.artha.link/api/v1

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxx   # server-side only, used by cron routes

# --- Resend (email digests) ---
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM="JobNetWork <jobs@yourdomain.com>"

# --- Cron auth (so only Vercel Cron / you can trigger the cron routes) ---
CRON_SECRET=choose-a-long-random-string
